.post-container
  width: 100%
  height: max-content
  padding: 1.8rem 0

.post-main
  width: 95%
  max-width: var(--meow-main-width)
  margin: 0 auto
  display: flex
  justify-content: center
  gap: 1rem

.post-content
  width: 100%
  max-width: none
  height: max-content
  padding: 2.2rem 2.5rem
  background-color: transparent
  border-radius: 0
  box-shadow: none
  animation: show-up .6s ease-out
  transition: background-color .2s ease-in

.post-title
  margin: 0 0 1.2rem 0
  line-height: 2.5rem
  font-size: $font-size-post-title
  font-weight: bold
  text-align: center
  animation: show-up 1s ease

.post-author
  font-size: 1.15rem
  text-align: center

.post
  max-width: 1100px
  width: 100%
  margin: 2.8rem auto 5rem
  font-size: 16px
  line-height: 1.6

  &[indent="true"]
    >p, >.hbe-container>div>p
      text-indent: 2em

  > p
    margin: 0 0 1.5em

.post-tail-tags
  margin: 1.5rem 0
  display: flex
  align-items: center
  flex-wrap: wrap
  gap: .2rem .5rem
  user-select: none

  a
    color: #817385
    border-radius: 0
    position: relative
    padding: .1rem .5rem
    transition: color .25s ease

    &:before
      content: '#'
      margin-right: .1rem

    &:hover
      color: #342A35

.post-nav
  width: 100%
  margin: 1.5rem 0
  display: flex
  justify-content: space-between
  gap: .5rem
  >a
    width: 50%
    padding: .5rem 1.2rem
    border: 1px dotted var(--font-color-light-3)
    border-radius: .8rem
    display: flex
    flex-direction: column
    font-size: .8rem
    color: var(--font-color-light-2)
    white-space: nowrap
    overflow: hidden
    position: relative
    span
      font-size: 1.25em
      overflow: hidden
      text-overflow: ellipsis
      color: var(--font-color-light-1)
      transition: all .5s ease
    &:after
      content: ""
      background-image: url(url-for(hexo-config('info.logo')))
      background-size: cover
      position: absolute
      top: 0
      width: 13%
      height: 100%
      opacity: 0
      transition: opacity .4s ease-in
    &:hover
      box-shadow: var(--meow-box-shadow)
      color: var(--font-color-light-1)
      &:after
        opacity: .7
      span
        font-weight: bold
        color: var(--theme-color)
    &[nopost]
      opacity: 0

.post-nav-prev:after
  right: 1.2rem

.post-nav-next
  text-align: right
  &:after
    left: 1.2rem
    transform: scaleX(-1)

.fiction-status
  text-align: center
  color: var(--font-color-light-3)
  font-weight: bold
  font-size: 1.2rem
  margin: 2rem 0

+meow-smallscreen()
  .post-container
    padding: 1.2rem 0

  .post-content
    padding: 1.6rem 1rem
  
  .post-title
    font-size: 1.6em
    margin-bottom: .6rem
  
  .post-author
    font-size: 1.1em
  
  .post
    margin: 2em 0 3.5em
    font-size: hexo-config('post.font_size_small') ? unquote(hexo-config('post.font_size_small')) : 1em
  
  .fiction-status
    font-size: 1.1em
    margin: 1.1em 0
  
  .post-tail-tags
    margin: 1.2em 0
  
  .post-nav>a
    font-size: .8em
    &:after
      display: none
  
  .post-content
  position: relative

  .post-home-link
    display: inline-block
    margin-bottom: 20px
    padding: 8px 0
    color: var(--font-color-light-1)
    font-family: Arial, "Microsoft YaHei", sans-serif
    font-size: 13px
    font-weight: 400
    text-decoration: none
    transition: color .2s ease

    &:hover
      color: var(--theme-color)