.paginator
  display: flex
  align-items: center
  justify-content: center
  gap: .7rem
  font-size: 16px
  text-align: center
  line-height: 2rem
  user-select: none

  *:not(.space)
    display: flex
    align-items: center
    justify-content: center
    width: 2rem
    height: 2rem
    background-color: transparent
    border: 1px solid var(--card-border-color)
    border-radius: 0
    box-shadow: none
    transition: all .2s ease

  span
    color: var(--font-color-light-1)

  a
    color: var(--font-color)
    text-decoration: none

    &:hover
      color: #ffffff
      background-color: var(--theme-color)
      border-color: var(--theme-color)

  .current
    color: #ffffff
    background-color: var(--theme-color)
    border-color: var(--theme-color)

  .space
    color: var(--font-color-light-1)

  +meow-smallscreen()
    font-size: 15px