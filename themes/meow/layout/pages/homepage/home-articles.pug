#home-main
  if page.tag
    .works-heading 标签 / #{page.tag}
  if is_category()
    - const categoryParents = {'龙族':'📖 书', '名柯':'👾 二次元', '银魂':'👾 二次元', '黑篮':'👾 二次元', '喜人':'🎭 Real People Slash', '明侦':'🎭 Real People Slash', '极挑':'🎭 Real People Slash', '乐夏':'🎭 Real People Slash', '梅溪湖':'🎭 Real People Slash', '脱人':'🎭 Real People Slash', '国产':'🎬 剧 / 影', '欧美':'🎬 剧 / 影'}
    - const parentName = categoryParents[page.category]
    .works-heading
      if parentName
        span= parentName + ' / ' + page.category
      else
        span= page.category

  - for (post of page.posts.toArray())
    .home-article
      - let article_cover = post.cover || post.photo
      if article_cover
        .home-article-cover
          a(href=url_for(post.path))
            img(src=url_for(article_cover) alt='Post Cover')

      .home-article-content(cover=article_cover ? '' : 'nocover')
        .home-article-title
          if post.sticky
            .home-article-sticky= __('sticky')
          a(href=url_for(post.path))= post.title

        if post.description
          .home-article-excerpt= post.description

        if post.warnings && post.warnings.length
          .home-article-warnings
            span 阅前须知：
            each warning, index in post.warnings
              if index > 0
                |  · 
              strong= warning

        .home-article-info-container
          .home-article-info
            if post.tags.length > 0
              .home-article-tags
                each tag in post.tags.toArray()
                  a(href=url_for(tag.path))= tag.name

          .home-article-func
            a.read-more-btn(href=url_for(post.path))= __('read_more') + " >>"

  .home-paginator
    != partial('components/paginator')
