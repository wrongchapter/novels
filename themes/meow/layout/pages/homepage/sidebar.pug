
aside#home-sidebar.bookshelf-sidebar
  .bookshelf-title 作品 / ARCHIVES
  label.bookshelf-drawer-close(for='bookshelf-drawer-toggle') × 关闭

  a.bookshelf-all(href=url_for('/'))
    | 全部作品

  - const currentCategory = is_category() ? page.category : ''

  .bookshelf-group
    details(open=currentCategory === '龙族')
      summary 小说
      .bookshelf-subcategories
        a(href=url_for('/categories/小说/龙族/')) 龙族

  .bookshelf-group
    details(open=['名柯', '银魂', '黑篮'].includes(currentCategory))
      summary 二次元
      .bookshelf-subcategories
        a(href=url_for('/categories/二次元/名柯/')) 名柯
        a(href=url_for('/categories/二次元/银魂/')) 银魂
        a(href=url_for('/categories/二次元/黑篮/')) 黑篮

  .bookshelf-group
    details(open=['喜人', '明侦', '极挑', '乐夏', '梅溪湖', '脱人'].includes(currentCategory))
      summary Real People Slash
      .bookshelf-subcategories
        a(href=url_for('/categories/Real-People-Slash/喜人/')) 喜人
        a(href=url_for('/categories/Real-People-Slash/明侦/')) 明侦
        a(href=url_for('/categories/Real-People-Slash/极挑/')) 极挑
        a(href=url_for('/categories/Real-People-Slash/乐夏/')) 乐夏
        a(href=url_for('/categories/Real-People-Slash/梅溪湖/')) 梅溪湖
        a(href=url_for('/categories/Real-People-Slash/脱人/')) 脱人

  .bookshelf-group
    details(open=['国产', '欧美'].includes(currentCategory))
      summary 剧 / 影
      .bookshelf-subcategories
        a(href=url_for('/categories/剧-影/国产/')) 国产
        a(href=url_for('/categories/剧-影/欧美/')) 欧美
  
  .bookshelf-about
    a(href=url_for('/about/')) 关于本站 / 作者碎碎念